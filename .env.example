# SFTP Configuration
SFTP_HOST=your-sftp-host.com
SFTP_PORT=22
SFTP_USERNAME=your_username
SFTP_PASSWORD=your_password
SFTP_SERVER_PATH=data/raw

# Local paths
LOCAL_STAGING_PATH=data/staging
TRACKER_DB_PATH=data/tracker.db

# Microsoft Fabric IDs (Workspace and Lakehouse)
FABRIC_WORKSPACE_ID=your-workspace-guid-here
FABRIC_LAKEHOUSE_ID=your-lakehouse-guid-here

# Azure Authentication
AZURE_CLIENT_ID=your-client-id-guid
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id-guid

# Local Development (optional)
MOCK_FABRIC=false
MOCK_FABRIC_PATH=data/fabric-mock

# Production Fabric Lakehouse Path
FABRIC_BASE_PATH=migration
FABRIC_LAKEHOUSE_NAME=migration_lakehouse
