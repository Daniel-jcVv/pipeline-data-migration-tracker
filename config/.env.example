# Environment Variables for Data Migration

# ccpy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!

# SFTP Configuration
SFTP_HOST=localhost
SFTP_PORT=22
SFTP_USERNAME=fabricdata
SFTP_PASSWORD=fabric25

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_REGION=us-east-1
S3_BUCKET_NAME=fabric-migration-data

# Microsoft Fabric configuration
FABRIC_WORKSPACE=your-workspace-name
FABRIC_LAKEHOUSE=migration-lakehouse
FABRIC_WAREHOUSE=migration-warehouse

# database configuration
DATABASE_PATH=data/migration.db

# pipeline configuration
FILE_PATTERN=*.csv
BATCH_SIZE=10
